#!/bin/bash
# px2-netrescue (px2-netrescue.service): a headless box with a broken network
# config is a brick. If there is no IPv4 default route 3 minutes after boot,
# bring eth0 up by hand (DHCP, then the static fallback from
# /etc/px2-npu-vpu/netrescue.conf) and start an SSH server, so the box can be
# reached and fixed. Uses only iproute2 and whatever DHCP client is present.
log=/var/lib/px2-npu-vpu/logs/netrescue.log
conf=/etc/px2-npu-vpu/netrescue.conf
IFACE=eth0 FALLBACK_IP='' FALLBACK_GW=''
# shellcheck disable=SC1090
[ -f $conf ] && . $conf
mkdir -p "${log%/*}"
ip link show "$IFACE" > /dev/null 2>&1 || IFACE=eth0

up() { ip -4 route show default | grep -q . && ping -c1 -W2 "$(ip -4 route show default | awk '{print $3; exit}')" > /dev/null 2>&1; }

for _ in $(seq 36); do
	up && exit 0
	sleep 5
done

{
	echo "$(date -Is) no working default route after 180 s, rescuing $IFACE"
	ip -br addr
	ip link set "$IFACE" up
	if command -v dhclient > /dev/null; then
		timeout 40 dhclient -1 "$IFACE"
	elif command -v dhcpcd > /dev/null; then
		timeout 40 dhcpcd -1 -4 "$IFACE"
	fi
	if ! up && [ -n "$FALLBACK_IP" ]; then
		ip addr add "$FALLBACK_IP" dev "$IFACE" 2> /dev/null
		ip route replace default via "$FALLBACK_GW" dev "$IFACE"
	fi
	grep -q '^nameserver' /etc/resolv.conf 2> /dev/null || echo "nameserver ${FALLBACK_GW:-9.9.9.9}" > /etc/resolv.conf
	for s in ssh dropbear; do
		systemctl unmask "$s" 2> /dev/null
		systemctl start "$s" 2> /dev/null && break
	done
	ip -br addr
	up && echo "rescued" || echo "still no route"
} >> $log 2>&1
