# Pinned inputs for a release build. build.sh reads this; CI may override
# KERNEL_VERSION (and then takes the SHA-256 GitHub publishes for the asset).

# Package revision: bump when anything but the kernel changes.
PKG_REV=2

# ophub Rockchip BSP kernel (kernel_rk35xx release of ophub/kernel)
KERNEL_VERSION=6.1.174
KERNEL_SHA256=6f126491b647a599cdc7ac22ef05a3b99effeb7de546c46624c0921accc3e785

# Rockchip MPP (VPU userspace), built from source
MPP_TAG=1.1.0

# airockchip/rknn-toolkit2: NPU runtime and demo assets. The runtime is under
# Rockchip's RKNN SDK licence, so releases do not carry it; install.sh fetches
# it from this commit and checks it.
RKNN_COMMIT=2c723177a94fac65cbc036d722907ddbc91980cf
RKNNRT_SHA256=4b6cc575bedf8952b13db4b1190fa3b3d2ac213f00be774ff6ccd19d651970c0
RKNN_API_H_SHA256=2d4160cd868efd7b83a72587e411c16d6972da5876e067bd73665cea778ce666
MOBILENET_SHA256=92b36515616fc568ddc573f07a345cf28441efe0d24ecc9b98051fe8bcfad980
DOG_JPG_SHA256=c350299c6283d5f62fecf1f845b6b3be9aafec8dff528ca09a129990f0a584b0
LITE2_WHL_SHA256=5cea0e6ff6e52974debf21719b4499803b5ab62550107274e709846531bf53e1
